LIBRARY libarm64ecfex.dll

EXPORTS
  BTCpu64FlushInstructionCache
  BTCpu64IosAddAliasMapping
  BTCpu64IosRipFromHostPC
  BTCpu64IosSetMonoBridge
  BTCpu64IosReleaseThreadHolds
  BTCpu64IsProcessorFeaturePresent
  BTCpu64NotifyMemoryDirty
  BTCpu64NotifyReadFile
  DispatchJump DATA
  RetToEntryThunk DATA
  ExitToX64 DATA
  BeginSimulation DATA
  FlushInstructionCacheHeavy
  NotifyImageMap
  NotifyMapViewOfSection
  NotifyMemoryAlloc
  NotifyMemoryFree
  NotifyMemoryProtect
  NotifyUnmapViewOfSection
  ProcessInit
  ProcessTerm
  ResetToConsistentState
  ThreadInit
  ThreadTerm
  UpdateProcessorInformation
  ; ml755: the VA band selector's deferred beacon buffer, exported as DATA so
  ; ntdll can print it from arm64ec_process_init_dispatchers(). The selector
  ; runs before the ARM64EC TEB exists and so cannot log for itself; ml751
  ; flushed it from Module.cpp after [build-id], which is never reached when
  ; the selector finds NO BAND -- exactly the failure that needs explaining.
  ios_va_log DATA
  ios_va_log_len DATA
  ; 2026-09-23: ExitFunctionEC's x64->EC translation counters, exported as DATA
  ; so ntdll-unix's 10s stats reporter can print `[ec-call] translated=N
  ; faulted=M` without calling into ARM64EC code from native code (which has
  ; killed launches before -- see the ml613 note in signal_arm64ec.c).
  ; [0] = translated inline to the JIT-pool copy, [1] = left in PE space.
  ; The reader must translate this export's PE VA through the JIT-pool mapping
  ; table first: the copy that EXECUTES is the pool copy, and its adrp-relative
  ; writes land in the POOL's .bss, not the image's.
  IosAliasStats DATA
